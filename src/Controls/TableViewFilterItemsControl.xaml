<UserControl x:Class="WinUI.TableView.Controls.TableViewFilterItemsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:not_win="http://uno.ui/not_win"
             xmlns:converters="using:WinUI.TableView.Converters"
             xmlns:local="using:WinUI.TableView"
             mc:Ignorable="not_win d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Sized like a context menu rather than a dialog: 12pt throughout, 26 px rows. The CheckBox
         template draws a literal 20x20 box that no property shrinks, so each one carries a render-only
         ScaleTransform — the box comes down with its text and the row height stays exactly what the
         list says it is. -->
    <Grid Margin="6,3"
          Width="208"
          Height="250">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="searchBox"
                 FontSize="12"
                 MinHeight="26"
                 Padding="8,2,8,3"
                 PlaceholderText="{x:Bind local:TableViewLocalizedStrings.SearchBoxPlaceholder}"
                 TextChanged="OnSearchBoxTextChanged"
                 win:PreviewKeyDown="OnSearchBoxKeyDown"
                 not_win:KeyDown="OnSearchBoxKeyDown" />
        <Border Grid.Row="1"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource MenuFlyoutSeparatorBackground}">
            <CheckBox x:Name="selectAllCheckBox"
                      Margin="8,5,8,1"
                      MinWidth="0"
                      MinHeight="24"
                      FontSize="15"
                      RenderTransformOrigin="0,0.5"
                      Content="{x:Bind local:TableViewLocalizedStrings.SelectAllParenthesized}"
                      Checked="OnSelectAllCheckBoxCheckChanged"
                      Unchecked="OnSelectAllCheckBoxCheckChanged">
                <CheckBox.RenderTransform>
                    <ScaleTransform ScaleX="0.8"
                                    ScaleY="0.8" />
                </CheckBox.RenderTransform>
            </CheckBox>
        </Border>
        <ListView x:Name="filterItemsList"
                  Grid.Row="2"
                  SelectionMode="None"
                  not_win:Margin="12,0,0,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding"
                            Value="8,0" />
                    <Setter Property="Margin"
                            Value="0" />
                    <Setter Property="MinHeight"
                            Value="26" />
                    <Setter Property="Height"
                            Value="26" />
                    <Setter Property="HorizontalAlignment"
                            Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TableViewFilterItem">
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                              MinWidth="0"
                              MinHeight="24"
                              FontSize="15"
                              RenderTransformOrigin="0,0.5"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <CheckBox.RenderTransform>
                            <ScaleTransform ScaleX="0.8"
                                            ScaleY="0.8" />
                        </CheckBox.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ValueText}"
                                       TextWrapping="NoWrap" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Visibility="{x:Bind ShowCount, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="(" />
                                <TextBlock Text="{x:Bind Count}" />
                                <TextBlock Text=")" />
                            </StackPanel>
                        </Grid>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
