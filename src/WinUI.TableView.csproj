<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>
      net8.0;
      net9.0;
      net10.0;
    </TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsAOTCompatible>true</IsAOTCompatible>
    <!--
      Uno0001: drag/drop theme animations in TableViewRow.xaml's reorder visual
        states (DragItemThemeAnimation / DragOverThemeAnimation /
        DropTargetItemThemeAnimation / VisualTransition.GeneratedDuration) are
        not implemented in Uno. Pure Windows-WinUI polish; safe no-op under Uno.
      IL2070/IL2075 were suppressed here, on the grounds that the consuming app
        did not trim so they were noise. RPM trims, so they are not noise, and a
        suppressed trimming warning does not stop the property being trimmed. It
        stops anyone hearing about it. They are on, and the binder carries
        real annotations that lead to Extensions/BindableTypeExtensions.cs: the
        single place this library admits the trimmer cannot follow a binding
        path, and whose header says what a consuming app must do to be AOT-safe.
      CS1591: missing XML doc on public members. The Release block below turns
        on GenerateDocumentationFile (for NuGet packing), which flags every
        FOBO-added member on SqlBackedItemsSource. DataMaker consumes this as a
        project reference, not a package, so the docs aren't published — and the
        fork's additions are intentionally undocumented vs upstream. Without
        this, any Release publish of the consuming app fails.
    -->
    <NoWarn>$(NoWarn);Uno0001;CS1591</NoWarn>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">
      net8.0-windows10.0.19041.0;
      net9.0-windows10.0.19041.0;
      net10.0-windows10.0.19041.0;
      $(TargetFrameworks);
    </TargetFrameworks>
  </PropertyGroup>

  <!--
    FOBO fork: this belongs to EVERY configuration, and used to be set for Release only (down in the
    packing block, where it reads as a NuGet concern). It is not one. It decides the uris this library's
    own themes are registered under, and without it Uno's XAML generator writes them as
    ms-appx:///WinUI.TableView/ plus the FULL BUILD PATH of the file:

      registered:  ms-appx:///WinUI.TableView/E:/Projects/WinUI.TableView/src/Themes/TableView.xaml
      looked up:   ms-appx:///WinUI.TableView/Themes/TableView.xaml

    The second is what Themes/Generic.xaml's own MergedDictionaries ask for, so the two never meet, and
    the first control to ask for its default style throws "Cannot locate resource from
    ms-appx:///WinUI.TableView/Themes/TableView.xaml" out of the middle of whatever page was being built.
    Nothing is broken by it in the end — the dictionary is built again on the next ask — but it is a
    genuine exception every consumer swallows, and it stops any debugger set to break on throws.

    So Release was always correct and Debug never was, which is exactly the shape that hides a bug: the
    shipped package resolved its themes and the builds anybody actually develops against did not.
  -->
  <PropertyGroup>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework))) == 'windows'">
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsSdkPackageVersion>10.0.19041.56</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WinUI.TableView.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <PackageReference Include="Uno.WinUI" />
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <PRIResource Include="**\*.resw" Exclude="bin\**\*.resw;obj\**\*.resw" />
  </ItemGroup>

    <ItemGroup>
        <Compile Update="TableView.*.cs">
            <DependentUpon>TableView.cs</DependentUpon>
        </Compile>
    </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PackageId>WinUI.TableView</PackageId>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- GenerateLibraryLayout was here. It is unconditional now — see the note above the first
         PropertyGroup for what it was costing every Debug build. -->
    <Description>TableView/DataGrid control for WinUI.</Description>
    <PackageTags>WinUI, WinAppSDK, Windows, UNO, XAML, TableView, DataGrid</PackageTags>
    <Product>WinUI TableView Control</Product>
    <RepositoryUrl>https://github.com/w-ahmad/WinUI.TableView</RepositoryUrl>
    <PackageProjectUrl>https://w-ahmad.github.io/WinUI.TableView/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\NuGet\$(Configuration)\</PackageOutputPath>
    <Authors>w-ahmad - https://github.com/w-ahmad</Authors>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\package-icon.png" Pack="true" PackagePath="\icon.png"/>
  </ItemGroup>

</Project>
