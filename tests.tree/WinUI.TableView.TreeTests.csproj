<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Repo uses central package management for the lib; this standalone test project
         pins its own test-stack versions. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Not part of the WinUI test harness: the tree kit is pure .NET, so these tests
         compile-link the sources directly and run everywhere (macOS/Linux/CI), unlike
         tests/ which needs a Windows WinUI host. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Tree\ITreeGridRow.cs" />
    <Compile Include="..\src\Tree\BulkObservableCollection.cs" />
    <Compile Include="..\src\Tree\TreeGridFlattener.cs" />
    <Compile Include="..\src\Tree\VirtualTreeModel.cs" />
    <Compile Include="..\src\Tree\ColumnStrip.cs" />
    <!-- Pure .NET as well: where a light row puts its text and its rules is arithmetic over the
         column widths, with no element in sight. -->
    <Compile Include="..\src\Tree\LightRowStrip.cs" />
    <!-- Pure .NET as well: whether a scroll is a wheel or a flick is decided from the deltas and
         their timing alone, with no pointer in sight. -->
    <Compile Include="..\src\Tree\WheelGesture.cs" />
    <!-- Pure .NET too: expression-tree property access, no WinUI types. It is what the SQL-backed
         (virtualized) sources read every cell through, so its per-type getter cache belongs here. -->
    <Compile Include="..\src\Extensions\ObjectExtensions.cs" />
    <Compile Include="..\src\Extensions\TypeExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
